# Indentation and line length per language, matching the Google style guides:
#   C++     https://google.github.io/styleguide/cppguide.html
#   Python  https://google.github.io/styleguide/pyguide.html
#   Kotlin  https://developer.android.com/kotlin/style-guide (Android style)
#   Rust    rustfmt defaults (Google has no Rust guide; see STYLE.md)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.h,*.cc,CMakeLists.txt}]
indent_style = space
indent_size = 2
max_line_length = 80

[*.py]
indent_style = space
indent_size = 4
max_line_length = 80

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 100
ktlint_code_style = android_studio

[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

[*.sh]
indent_style = space
indent_size = 2
